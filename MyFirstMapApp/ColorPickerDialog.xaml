<Window x:Class="MyFirstMapApp.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Height="480" Width="460" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" MinHeight="72" />
        </Grid.RowDefinitions>

        <!-- 深蓝色标题栏（与主界面侧边栏一致 #1E293B） -->
        <Border Grid.Row="0" Background="#1E293B" Padding="15,10" Margin="0,0,0,6">
            <TextBlock Text="选择图层颜色" FontSize="16" Foreground="White" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="预设颜色" FontSize="14" FontWeight="Medium" Margin="0,0,0,10" Foreground="#333333" />

                <WrapPanel Width="160" ItemWidth="30" ItemHeight="30" HorizontalAlignment="Left">
                    <Border Width="24" Height="24" Background="#FF0000" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF0000" />
                    <Border Width="24" Height="24" Background="#FF6B6B" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF6B6B" />
                    <Border Width="24" Height="24" Background="#FF8E8E" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF8E8E" />
                    <Border Width="24" Height="24" Background="#FFB3B3" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FFB3B3" />
                    <Border Width="24" Height="24" Background="#FF0066" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF0066" />
                    <Border Width="24" Height="24" Background="#FF00CC" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF00CC" />
                    <Border Width="24" Height="24" Background="#9900FF" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#9900FF" />
                    <Border Width="24" Height="24" Background="#6600FF" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#6600FF" />
                    <Border Width="24" Height="24" Background="#0066FF" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#0066FF" />
                    <Border Width="24" Height="24" Background="#00B3FF" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#00B3FF" />
                    <Border Width="24" Height="24" Background="#00FFFF" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#00FFFF" />
                    <Border Width="24" Height="24" Background="#00FFCC" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#00FFCC" />
                    <Border Width="24" Height="24" Background="#00FF66" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#00FF66" />
                    <Border Width="24" Height="24" Background="#66FF00" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#66FF00" />
                    <Border Width="24" Height="24" Background="#CCFF00" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#CCFF00" />
                    <Border Width="24" Height="24" Background="#FFFF00" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FFFF00" />
                    <Border Width="24" Height="24" Background="#FFCC00" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FFCC00" />
                    <Border Width="24" Height="24" Background="#FF9900" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF9900" />
                    <Border Width="24" Height="24" Background="#FF6600" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#FF6600" />
                    <Border Width="24" Height="24" Background="#CC6600" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#CC6600" />
                    <Border Width="24" Height="24" Background="#000000" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#000000" />
                    <Border Width="24" Height="24" Background="#333333" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#333333" />
                    <Border Width="24" Height="24" Background="#666666" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#666666" />
                    <Border Width="24" Height="24" Background="#999999" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#999999" />
                    <Border Width="24" Height="24" Background="#CCCCCC" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#CCCCCC" />
                    <Border Width="24" Height="24" Background="#E5E5E5" Margin="3" Cursor="Hand" CornerRadius="4" MouseDown="PresetColor_Click" Tag="#E5E5E5" />
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="自定义颜色" FontSize="14" FontWeight="Medium" Margin="0,0,0,10" Foreground="#333333" />

                <Border Width="180" Height="100" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                    <Border x:Name="ColorPreview" Background="White" CornerRadius="4" Margin="2" />
                </Border>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="R" Width="20" FontSize="12" Foreground="#CC0000" />
                        <Slider x:Name="sliderR" Minimum="0" Maximum="255" Width="150" 
                                TickFrequency="1" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="txtR" Width="30" FontSize="12" TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="G" Width="20" FontSize="12" Foreground="#00CC00" />
                        <Slider x:Name="sliderG" Minimum="0" Maximum="255" Width="150" 
                                TickFrequency="1" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="txtG" Width="30" FontSize="12" TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="B" Width="20" FontSize="12" Foreground="#0000CC" />
                        <Slider x:Name="sliderB" Minimum="0" Maximum="255" Width="150" 
                                TickFrequency="1" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="txtB" Width="30" FontSize="12" TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="A" Width="20" FontSize="12" Foreground="#666666" />
                        <Slider x:Name="sliderA" Minimum="0" Maximum="255" Width="150" 
                                TickFrequency="1" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="txtA" Width="30" FontSize="12" TextAlignment="Right" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="HEX:" FontSize="12" Foreground="#666666" RenderTransformOrigin="0.491,-0.108" />
                    <TextBox x:Name="txtHex" Width="100" Margin="5,0,0,0" FontSize="12" 
                             TextChanged="TxtHex_TextChanged" RenderTransformOrigin="0.552,-1.382" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="80" Height="32" Margin="0,0,10,0" 
                        Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1"
                        Click="BtnCancel_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="确定" Width="80" Height="32" 
                        Background="#1E293B" Foreground="White" BorderThickness="0"
                        Click="BtnOK_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>