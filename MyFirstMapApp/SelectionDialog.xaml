<Window x:Class="MyFirstMapApp.SelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择项" Height="350" Width="400" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblMessage" 
                   Text="请选择一项：" 
                   FontSize="14" 
                   Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="LstItems" 
                 Margin="0,0,0,10"
                 SelectionMode="Single"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,10,0" 
                    IsDefault="True" Click="BtnOK_Click"/>
            <Button Content="取消" Width="80" Height="30" 
                    IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>